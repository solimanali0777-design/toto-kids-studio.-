{
  "name": "toto-kids-studio-v7",
  "version": "7.15.0-alpha.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:engines": "tsc -p tsconfig.test-engines.json && node --test tests/engine-smoke.test.mjs",
    "test:soly-live": "node --test tests/soly-live.test.mjs",
    "start:gateway": "node backend/solyGatewayServer.mjs",
    "preflight": "node scripts/build-preflight.mjs",
    "check:ui": "tsc -p tsconfig.ui-syntax.json --noEmit",
    "verify": "npm test && npm run test:engines && npm run check:ui && tsc -p tsconfig.live.json --noEmit"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "lucide-react": "1.47.0",
    "ai": "6.0.282",
    "workflow": "4.8.9",
    "@workflow/ai": "4.2.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "vite": "8.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2"
  }
}
